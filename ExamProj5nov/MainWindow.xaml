<Window x:Class="ExamProj5nov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExamProj5nov"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Border Padding="15">
            <StackPanel>
                <Button Content="Товары" FontSize="14" Margin="7" Click="BtnProducts_Click"></Button>
                <Button Content="Клиенты" FontSize="14" Margin="7" Click="BtnClients_Click"></Button>
                <Button Content="Заказы" FontSize="14" Margin="7"></Button>
            </StackPanel>
        </Border>

        <Frame Name="MainFrame" NavigationUIVisibility="Hidden" Grid.Column="1"></Frame>
    </Grid>
</Window>
