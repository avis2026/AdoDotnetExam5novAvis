<Page x:Class="ExamProj5nov.Pages.AddNewProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ExamProj5nov.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddNewProductPage">

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="20" Width="400">
                <TextBox Text="Название" Name="Name" Padding="8,4" Margin="0,0,0,20"></TextBox>
                <TextBox Text="Категория 1-3" Name="Category" Padding="8,4" Margin="0,0,0,20"></TextBox>
                <TextBox Text="Цена" Name="Price" Padding="8,4" Margin="0,0,0,20"></TextBox>
                <TextBox Text="Количество" Name="StockQuantity" Padding="8,4" Margin="0,0,0,20"></TextBox>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Сохранить" Click="SaveProduct_Click" Padding="5" Margin="0,10,10,0"></Button>
                    <Button Content="Отменить" Click="Cancel_Click" Padding="5" Margin="0,10,10,0"></Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
