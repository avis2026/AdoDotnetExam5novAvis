<Page x:Class="ExamProj5nov.Pages.ClientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ExamProj5nov.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ClientsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="10">

            <TextBlock x:Name="Profile" Grid.Row="0" Text="Добро пожаловать, " 
       FontSize="16" FontWeight="Bold" Margin="10"/>

            <StackPanel>
                <Label Content="Поиск по названию"/>
                <TextBox Padding="5" Name="SearchBox"/>
            </StackPanel>

            <StackPanel>
                <Label Content="Фильтрация"/>
                <ComboBox Name="RoleFilterBox">
                    <ComboBoxItem Content="Все роли" IsSelected="True"/>
                    <ComboBoxItem Content="1 - Администраторы"/>
                    <ComboBoxItem Content="2 - Пользователи"/>
                </ComboBox>
                <Label Content="Сортировка"/>
                <ComboBox Name="SortBox">
                    <ComboBoxItem Content="Фамилия А -> Я" IsSelected="True" />
                    <ComboBoxItem Content="Фамилия Я -> А"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="Применить" Click="BtnApply_Click"/>
                <Button Content="Сбросить" Click="BtnReset_Click" Margin="10,0,0,0"/>
                <Button Content="Добавить клиента" Click="AddNewClient_Click" Margin="10,0,0,0"></Button>
            </StackPanel>
        </StackPanel>



        <DataGrid Grid.Row="1" Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Полное имя" Binding="{Binding FullName}"/>
                <DataGridTextColumn Header="Почта" Binding="{Binding Email}"/>
                <DataGridTextColumn Header="Номер телефона" Binding="{Binding PhoneNumber}"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}"/>
                <DataGridTemplateColumn Header="Действие">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Button Content="Редактировать" Margin="5" Padding="10,5"></Button>
                                <Button Content="Удалить" Click="DeleteClient_Click" Margin="5" Padding="10,5"></Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Сформировать отчет"
            
            Margin="10"/>
            
            <Button Content="Выход" 
             
            Margin="10" 
            />
        </StackPanel>
    </Grid>
</Page>
